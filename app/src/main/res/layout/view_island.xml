<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_island_pill"
    android:elevation="4dp"
    android:orientation="vertical"
    android:paddingHorizontal="18dp"
    android:paddingVertical="10dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:id="@+id/islandDot"
            android:layout_width="9dp"
            android:layout_height="9dp" />

        <TextView
            android:id="@+id/tvIslandPhase"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:textColor="#9CA3AF"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvIslandSubject"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvIslandCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:fontFamily="monospace"
            android:textColor="#26C6DA"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnIslandClose"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:paddingHorizontal="6dp"
            android:text="×"
            android:textColor="#9CA3AF"
            android:textSize="18sp"
            android:visibility="gone" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/islandProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="9dp"
        android:max="100"
        android:progressDrawable="@drawable/progress_track" />

    <LinearLayout
        android:id="@+id/islandExpanded"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvIslandNext"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:textColor="#E5E7EB"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvIslandHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="长按拖动位置 · 再次点击收起"
            android:textColor="#6B7280"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
